%% The terminal render target calls `io_ansi`, which earlier releases lack. Remote
%% calls resolve at run time, so those still compile and only fail with `undef`
%% when something renders to a terminal; declaring it fails upfront instead.
{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% Test fixtures use `?terminal`, which the parse transform compiles by calling
%% the backend, so it must be built before anything that includes the header.
{erl_first_files, ["src/arizona_terminal.erl"]}.

%% Pinned to one arizona commit on main, so a later arizona change cannot break this
%% build unannounced; bump the ref deliberately. Replaced by a Hex version once
%% arizona releases the declared render-target support.
{deps, [
    {arizona,
        {git, "https://github.com/arizona-framework/arizona.git",
            {ref, "fc145d16803762593fd89fc4d9ff78090ce34393"}}}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        compiler,
        syntax_tools,
        common_test,
        ssh,
        public_key,
        tools
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]},
    incremental
]}.

{alias, [
    {test, [
        {ct, "--cover"}
    ]},
    {check_cover, [
        {cover, "--min_coverage 80 --verbose"}
    ]}
]}.

{profiles, [
    {default, [
        {xref_checks, [
            exports_not_used,
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]},
    {test, [
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {erl_opts, [debug_info, nowarn_missing_spec, warnings_as_errors]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"},
    {rebar3_hank, "2.0.1"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{hank, [
    {ignore, [
        {"src/arizona_terminal_driver.erl", [unused_callbacks]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "rebar.config",
        "scripts/*.escript",
        "src/*.app.src",
        "src/**/*.erl",
        "include/*.hrl",
        "test/**/*.erl"
    ]}
]}.

{ex_doc, [
    {extras, ["README.md", "LICENSE.md"]},
    {main, "README.md"},
    {api_reference, false},
    {source_url, "https://github.com/arizona-framework/arizona_terminal"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
